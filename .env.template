# 复制本文件为 .env 并填入真实的配置

# MongoDB配置
MONGO_URI=mongodb://localhost:27017
MONGO_DB=finance
DATA_DB_NAME=quant_data

# FastAPI配置
HOST=0.0.0.0
PORT=8000

# Strategy Manager Worker API 配置
# 设置此变量以连接到 quant-strategy-manager 的 Worker API
# 本地部署: http://localhost:5000/api/workers
# 远程部署: http://<remote-ip>:<port>/api/workers
REMOTE_WORKER_API=http://localhost:5000/api/workers

# 是否只使用远程 API（不尝试本地 orchestrator）
USE_REMOTE_ONLY=true

# Worker WebSocket URL 输出模式（给 quant-strategy-manager 使用）
# true: 返回 ws://<PUBLIC_HOST>/ws/{port}（通过 Nginx 代理，推荐生产）
# false: 返回 ws://<worker-host>:<worker-port>（直连端口，适合本地开发）
USE_NGINX_WEBSOCKET=true

# 对外可访问的 WebSocket 网关地址（host[:port]）
# 示例：10.181.200.185:8088 或 strategy.example.com
PUBLIC_HOST=localhost:8088

# 是否使用 HTTPS 站点（决定返回 ws:// 还是 wss://，以及部分邮件/链接里的 scheme）
USE_HTTPS=false

# ---------------------------------------------------------------------------
# 公网可访问的「站」与「链」：FRONTEND_URL 与 PUBLIC_HOST 的区别
# - PUBLIC_HOST：对外的 host[:port]，与 USE_HTTPS 一起拼出站点/API 的访问形态；常用于 Worker WebSocket、
#   管理员「审批通过」等邮件里拼「登录地址」，格式通常不带 https:// 前缀，例如 10.0.0.1:8088。
# - FRONTEND_URL：浏览器里单页（Vue）应用的完整基址，需带协议。用于用户邮件中的前端路由，例如
#   /activate?token=（注册自助开通）、/reset-password?token=（忘记密码）等。开发环境常见为
#   http://localhost:5173；同域反代时与「用户实际打开的站点」一致即可，可设为
#   https + PUBLIC_HOST，例如 https://strategy.example.com（以你线上为准）。
# - API_PUBLIC_URL（可选）：明确给出对外 API 根 URL 时，用于邮件里直链到 /api/user/verify-email 等；
#   不填时由 USE_HTTPS + PUBLIC_HOST + PUBLIC_API_PORT 回退拼接。
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
#API_PUBLIC_URL=
# 仅当未设 API_PUBLIC_URL 且需单独指定「API 端口」时使用（与 PUBLIC_HOST 中端口可能不同）
#PUBLIC_API_PORT=

# JWT认证配置
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRE_MINUTES=10080

# SMTP 邮件（email_service 主通道：审批/登录提醒/注册自助开通等；未配置发件人密码时这些邮件会跳过）
# 发件人显示名（如「悟空量化」），可与 SMTP_FROM_EMAIL 同时配置
FROM_NAME=悟空量化
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password  # Gmail 需使用应用专用密码
SMTP_FROM_EMAIL=noreply@yourdomain.com

# 用于用户注册后「邮件点链接自助开通」、重发开通邮件、改邮箱/密码等邮件里 JWT
# 与登录用的 JWT_SECRET_KEY 无关，但生产环境务必改为长随机串
EMAIL_VERIFICATION_SECRET=email-verification-secret-change-in-production
# 注册成功是否发「完成开通」邮件（依赖 SMTP 已配置；false/0/no 时关闭，仅依赖管理员审批）
#SEND_REGISTRATION_ACTIVATION_EMAIL=true
# 注册自助开通与重发邮件中链接的过期时间（天）
#ACCOUNT_ACTIVATION_TOKEN_DAYS=7

# SMTP配置说明：
# Gmail:
#   1. 登录Google账户 https://myaccount.google.com/security
#   2. 启用"两步验证"
#   3. 生成"应用专用密码"
#   4. SMTP_SERVER=smtp.gmail.com, SMTP_PORT=587
#
# QQ邮箱:
#   SMTP_SERVER=smtp.qq.com, SMTP_PORT=587
#   需要在邮箱设置中开启SMTP服务并获取授权码
#
# 163邮箱:
#   SMTP_SERVER=smtp.163.com, SMTP_PORT=465
#   需要在邮箱设置中开启SMTP服务

# Hermes Agent（docker compose 服务 hermes）：网关 OpenAI 兼容 API 默认端口 8642
# chat/completions：compose 会注入 OPENAI_*；主模型仍须在 hermes-data/config.yaml 设 provider:custom（勿留 openrouter），见 hermes-custom-endpoint.config.example.yaml
# 探测不要用 curl http://127.0.0.1:8642/（根路径常为 404）；应请求 /v1/models 并带 Bearer，见 docker-compose 注释
# 生产环境务必改为长随机串；请求头 Authorization: Bearer <HERMES_API_SERVER_KEY>
#HERMES_API_SERVER_ENABLED=true
#HERMES_API_SERVER_KEY=dev-hermes-api-key-change-me
# 未配 Telegram/Discord 等 TELEGRAM_ALLOWED_USERS 时网关会告警；私网本地开发可设 true，公网务必 false 并配白名单
#HERMES_GATEWAY_ALLOW_ALL_USERS=true

# quant-data-engine 可选：按任务覆盖盘后采集 cron（默认留空使用内置时间）
# 格式：m h dom mon dow，例如 "30 18 * * 1-5"
# CRON_STOCK_DAILY=
# CRON_INDEX_DAILY=
# CRON_ETF_DAILY=
# CRON_FINANCIAL_DAILY=
# CRON_MONEYFLOW_DAILY=
# CRON_SENTIMENT_DAILY=
# CRON_HOTSTOCK_DAILY=
