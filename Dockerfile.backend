# =============================================================================
# Stage 1: Build — install gcc for C-extension packages, use China pip mirror
# =============================================================================
FROM python:3.11-slim AS builder

WORKDIR /app

# China pip mirror (fastest in China)
RUN pip config set global.index-url https://mirrors.aliyun.com/pypi/simple/ && \
    pip config set global.trusted-host mirrors.aliyun.com

# Build deps for C extensions: cryptography, bcrypt, numpy, psutil
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc \
        libffi-dev \
        python3-dev \
    && rm -rf /var/lib/apt/lists/*

# COPY requirements FIRST — Docker caches this layer until file changes
COPY requirements.txt .

# Install all deps in one layer (heavy, but fully cached after first build)
RUN pip install --no-cache-dir -r requirements.txt

# =============================================================================
# Stage 2: Runtime — minimal slim image, no build tools
# =============================================================================
FROM python:3.11-slim

WORKDIR /app
ENV PYTHONPATH=/app

# Runtime deps only
RUN apt-get update && apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

# Copy pre-installed packages from builder (avoids re-downloading)
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

RUN mkdir -p /app/logs

# Copy source code (this layer changes most often)
COPY . .

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:3001/health || exit 1

EXPOSE 3001

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "3001", "--log-level", "info"]
